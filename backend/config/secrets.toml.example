# Copy to secrets.toml (same folder) and fill real values.
# DO NOT commit secrets.toml to git!
# Part 6: run  python scripts/check_email_otp_safety.py

OPENAI_API_KEY = "PASTE_YOUR_OPENAI_KEY_HERE"

# ── Gmail SMTP for OTP emails ────────────────────────────────────────────────
# 1) Gmail account → Google Account → Security
# 2) Turn on 2-Step Verification
# 3) App passwords → Mail → Windows Computer → Generate
# 4) Paste the 16-character App Password below (NOT your normal Gmail password)
# 5) Restart: npm run dev:all
# 6) Test:  python scripts/test_smtp_config.py
# 7) Safety: python scripts/check_email_otp_safety.py
#
# Until this section is filled with real values, AutiStudy stays in local DEV
# mode (OTP may appear in UI / console). Production must set
# AUTISTUDY_ENV=production (or AUTH_PRODUCTION=1) and configure SMTP —
# then OTP plaintext is never logged or returned in the API.

[smtp]
host = "smtp.gmail.com"
port = 587
user = "your.gmail@gmail.com"
password = "xxxx xxxx xxxx xxxx"
from = "your.gmail@gmail.com"
